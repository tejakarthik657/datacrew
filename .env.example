# Copy to .env. Nothing here is required: defaults run fully offline with no keys.
MODE=local                 # local | byo | cloud  (cloud LLMs only allowed in byo/cloud)
DATABASE_URL=              # default sqlite:///./data/datacrew.db ; Postgres via postgresql+psycopg://...
STORAGE_DIR=               # default ./data/storage
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL_HOURS=12
LLM_PROVIDER=mock          # mock | ollama | openai_compat
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
LLM_BASE_URL=              # e.g. https://api.groq.com/openai/v1 (needs MODE=byo or cloud)
LLM_API_KEY=
LLM_MODEL=
MAX_UPLOAD_MB=50

# Neo4j Graph Database
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Google OAuth Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
