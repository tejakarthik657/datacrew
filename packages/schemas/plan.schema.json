{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DataCrew cleaning plan",
  "type": "object",
  "required": ["dataset_type", "steps"],
  "additionalProperties": false,
  "properties": {
    "dataset_type": {"type": "string", "minLength": 1},
    "steps": {
      "type": "array",
      "maxItems": 60,
      "items": {
        "type": "object",
        "required": ["id", "type", "columns", "params", "rationale", "confidence", "risk_level", "affected_rows_estimate", "reversible"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^s[0-9]+$"},
          "type": {"enum": ["drop_duplicates", "fuzzy_dedupe", "fill_missing", "standardize_dates", "normalize_values", "normalize_phone", "rename_columns", "split_column", "merge_columns", "cast_type", "remove_rows", "flag_outliers", "restructure_to_schema", "validate_rule"]},
          "columns": {"type": "array", "items": {"type": "string"}},
          "params": {"type": "object"},
          "rationale": {"type": "string"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "risk_level": {"enum": ["low", "medium", "high"]},
          "affected_rows_estimate": {"type": "integer", "minimum": 0},
          "reversible": {"type": "boolean"}
        }
      }
    }
  }
}
